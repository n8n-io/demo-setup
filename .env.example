# =============================================================================
# Self-Hosted AI Starter Kit — Environment Variables
# =============================================================================
# Copy this file to .env and update values before starting services:
#   cp .env.example .env
#
# IMPORTANT: Change all default passwords and secrets before any deployment.
# =============================================================================

# --- PostgreSQL Configuration ------------------------------------------------
# Database superuser name (used by n8n to connect)
POSTGRES_USER=root
# Database password (REQUIRED — change this for any non-local deployment)
POSTGRES_PASSWORD=password
# Database name where n8n stores its data
POSTGRES_DB=n8n

# --- n8n Security Configuration ----------------------------------------------
# Encryption key for n8n credential storage (REQUIRED — generate a strong value)
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=super-secret-key
# JWT signing secret for n8n user management (REQUIRED — generate a strong value)
# Generate with: openssl rand -hex 32
N8N_USER_MANAGEMENT_JWT_SECRET=even-more-secret
# How n8n stores binary data (default: filesystem)
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

# --- Ollama Configuration ----------------------------------------------------
# For Mac users running Ollama locally (outside Docker), uncomment:
# OLLAMA_HOST=host.docker.internal:11434
# See: https://github.com/n8n-io/self-hosted-ai-starter-kit#for-mac--apple-silicon-users
